{
  "name": "hackdatapro",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "installBackend": "npm install express multer cors bcryptjs body-parser cloudinary cookie-parser dotenv express-fileupload jsonwebtoken mongoose nodemailer stripe validator colors express-async-handler nodemon mongodb concurrently axios",
    "installClient": "npm install --prefix frontend",
    "installPython": "pip install flask roboflow --prefix python",
    "install": "concurrently \"npm run installBackend\" \"npm run installClient\" ",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server \" \"npm run client\" ",
    "ngrok": "ngrok http http://localhost:3000 --host-header=\"localhost:3000\""
  },
